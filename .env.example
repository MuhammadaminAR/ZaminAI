# Supabase project configuration
# Public/client values may be exposed in browser bundles; never use a service-role key in VITE_ variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_ON_SERVER

# Mapbox public token (restrict allowed URLs in the Mapbox dashboard)
VITE_MAPBOX_PUBLIC_TOKEN=YOUR_PUBLIC_MAPBOX_TOKEN

# Optional canonical site URL for email/OAuth redirects
VITE_PUBLIC_APP_URL=http://localhost:3000

# Server-only model and provider settings, where used by enabled features
GEMINI_API_KEY=SET_ONLY_ON_SERVER
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1
CRON_SECRET=SET_ONLY_ON_SERVER
CRON_SECRET_PREVIOUS=

# Used only for database migration tooling
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
